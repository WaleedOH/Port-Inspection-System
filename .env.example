# Copy this file to ".env" and fill it in. The real .env is never committed.
# Load it with:  uvicorn app.main:app --env-file .env

# First administrator account (only used the very first time the app starts)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-password

# Signs login cookies. Make one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Set to 1 when the app is served over HTTPS (always, on a real deployment)
COOKIE_SECURE=0

# Where saved data lives. Leave DATABASE_URL empty to use a SQLite file in DATA_DIR.
# Set it to a PostgreSQL address (Supabase, Neon, your own server) for permanent storage:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATA_DIR=data

# Modules
VIN_DECODER=both                # own vehicle database first, NHTSA online if missing; or: offline, online
WEB_PRICE_LOOKUP=on             # read public car-price pages for models missing from our data; or: off
PRICE_RESEARCH=off              # or: claude (web search for missing prices; needs ANTHROPIC_API_KEY)
DOCUMENT_READER=browser-ocr     # or: claude (needs ANTHROPIC_API_KEY and "pip install anthropic")
PRICING_PROVIDER=mock
# ANTHROPIC_API_KEY=
